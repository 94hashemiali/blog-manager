# Gemini API key for the application's AI features (article generation, image generation, SEO).
# Set this in your local Cursor/.env file. Do not use AI Studio as the development environment.
GEMINI_API_KEY=

# Optional model overrides. Defaults match the installed @google/genai SDK.
# GEMINI_TEXT_MODEL=gemini-3.1-flash-lite
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# Image quality gate (0-100). Regeneration happens when a score fails.
# IMAGE_QUALITY_MIN_OVERALL=75
# IMAGE_QUALITY_MIN_RELEVANCE=75
# IMAGE_QUALITY_MIN_TECHNICAL=70
# IMAGE_QUALITY_MIN_SPECIFICITY=75
# IMAGE_QUALITY_MAX_GENERICNESS=40
# IMAGE_QUALITY_MIN_NOVELTY=70
# IMAGE_QUALITY_MIN_REALISM=70
# IMAGE_QUALITY_MIN_ANATOMY=70
# IMAGE_MAX_GENERATION_ATTEMPTS=3

# APP_URL is optional for local development.
APP_URL=http://localhost:3000

# Web research search APIs are NOT configured. Do not set fake keys.
# When a real provider is added later (e.g. Serper / Google CSE), wire it in
# server/research/providers.ts — until then the UI shows NOT_CONFIGURED.
# SERPER_API_KEY=
# GOOGLE_CSE_ID=
# GOOGLE_CSE_API_KEY=
